# PiUI web/API service. No variables are required for `pi-worker web`.
# PIUI_HOST=127.0.0.1
# PIUI_PORT=8787
# PIUI_AUTH_TOKEN=replace-with-a-long-random-token
# PIUI_DATA_DIR=~/.piui
# PIUI_SHUTDOWN_TIMEOUT_MS=10000

# Pi SDK selection. PIUI_SDK_PATH takes precedence over PIUI_USE_SYSTEM_PI.
# PIUI_USE_SYSTEM_PI=1
# PIUI_SDK_PATH=/path/to/pi-coding-agent
# PIUI_SKIP_SDK_VERSION_CHECK=0

# Native Pi storage.
# PI_CODING_AGENT_DIR=~/.pi/agent
# PI_CODING_AGENT_SESSION_DIR=~/.pi/agent/sessions

# Optional outbound proxy inherited by the Pi service and SDK.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost

# Provider credentials are read by the native Pi SDK.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Browser development/build endpoint. The Tauri desktop app uses its server list instead.
# VITE_PIUI_API=http://127.0.0.1:8787
